[Unit]
Description=Tuitui Run leaderboard API
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ts3/tuitui-api
Environment=TUITUI_DB=/home/ts3/tuitui-api/data/scores.db
ExecStart=/home/ts3/tuitui-api/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8091
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
